{
  "name": "project-brain-skill-tools",
  "version": "1.0.0",
  "private": true,
  "description": "Local semantic project brain scripts for agent skill usage.",
  "type": "module",
  "scripts": {
    "brain:init": "node scripts/brain-init.mjs",
    "brain:index": "node scripts/brain-index.mjs",
    "brain:search": "node scripts/brain-search.mjs",
    "brain:ask": "node scripts/brain-ask.mjs",
    "brain:sync": "node scripts/brain-sync.mjs",
    "brain:guard": "node scripts/brain-guard.mjs",
    "brain:health": "node scripts/brain-health.mjs",
    "brain:session": "node scripts/brain-session.mjs",
    "brain:lease": "node scripts/brain-lease.mjs",
    "brain:work": "node scripts/brain-work.mjs",
    "brain:pr": "node scripts/brain-pr.mjs",
    "brain:ticket": "node scripts/brain-ticket.mjs",
    "brain:orchestrate": "node scripts/brain-orchestrate.mjs",
    "brain:worktree": "node scripts/brain-worktree.mjs",
    "brain:pack": "node scripts/brain-pack.mjs",
    "brain:symbol": "node scripts/brain-search.mjs --type code --symbol",
    "brain:impact": "node scripts/brain-impact.mjs",
    "brain:graph": "node scripts/brain-graph.mjs",
    "brain:eval": "node scripts/brain-eval.mjs",
    "brain:maintain": "node scripts/brain-maintain.mjs",
    "brain:compact": "node scripts/brain-compact.mjs",
    "brain:adr": "node scripts/brain-adr.mjs",
    "brain:lint-conventions": "node scripts/brain-lint-conventions.mjs",
    "brain:link-check": "node scripts/brain-link-check.mjs",
    "brain:install-cursor-hooks": "node scripts/install-cursor-hooks.mjs",
    "brain:install-hooks": "bash bin/install-hooks.sh",
    "brain:update-skill": "bash bin/update.sh",
    "test": "node --test tests/*.test.mjs tests/**/*.test.mjs"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "fast-glob": "^3.3.2"
  },
  "optionalDependencies": {
    "@lancedb/lancedb": "^0.9.0",
    "typescript": "^5.6.0"
  },
  "devDependencies": {}
}
