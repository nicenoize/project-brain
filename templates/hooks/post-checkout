#!/usr/bin/env bash
set -euo pipefail

previous_head="${1:-}"
new_head="${2:-}"
branch_checkout="${3:-0}"

if [ "$branch_checkout" = "1" ] && [ "$previous_head" != "$new_head" ] && command -v npm >/dev/null 2>&1; then
  npm run brain:update-skill || true
  npm run brain:maintain -- --hook || true
fi

# --- brain:brief proactive pre-touch advisory (OPT-IN) ---------------------
# Surfaces leases/ADRs/cross-project edges for the working tree right after a
# branch switch, so the brain taps you on the shoulder before you edit. This
# is advisory only and must NEVER block a checkout: every failure soft-exits 0.
# Enable by setting BRAIN_BRIEF_ON_CHECKOUT=1 in your environment. Leaving it
# unset keeps checkout behavior identical to before.
if [ "${BRAIN_BRIEF_ON_CHECKOUT:-0}" = "1" ] && [ "$branch_checkout" = "1" ] \
  && [ "$previous_head" != "$new_head" ] && command -v npm >/dev/null 2>&1; then
  npm run brain:brief || true
fi
# --- end brain:brief snippet ----------------------------------------------
