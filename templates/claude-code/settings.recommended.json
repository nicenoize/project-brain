{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run brain:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '=== Project Brain: Active State ===' && cat .project-brain/active_state.md"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/skills/project-brain/scripts/brain-route.mjs\" --hook --event sessionstart || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/skills/project-brain/scripts/brain-route.mjs\" --hook --event userpromptsubmit || true"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/skills/project-brain/scripts/brain-session-digest.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/skills/project-brain/scripts/brain-session-digest.mjs\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/skills/project-brain/scripts/brain-prune.mjs\" --apply >/dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/skills/project-brain/scripts/brain-lint-conventions.mjs\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/skills/project-brain/scripts/brain-route-tool.mjs\" --surface bash || true"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/skills/project-brain/scripts/brain-route-tool.mjs\" --surface read || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/skills/project-brain/scripts/brain-stage-dirty.mjs\" || true"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "agent-teams@claude-code-workflows": true,
    "agent-orchestration@claude-code-workflows": true,
    "comprehensive-review@claude-code-workflows": true,
    "security-scanning@claude-code-workflows": true,
    "backend-api-security@claude-code-workflows": true,
    "frontend-mobile-security@claude-code-workflows": true,
    "unit-testing@claude-code-workflows": true,
    "tdd-workflows@claude-code-workflows": true,
    "api-testing-observability@claude-code-workflows": true,
    "performance-testing-review@claude-code-workflows": true,
    "full-stack-orchestration@claude-code-workflows": true,
    "javascript-typescript@claude-code-workflows": true,
    "caveman@caveman": true
  },
  "extraKnownMarketplaces": {
    "claude-code-workflows": {
      "source": {
        "source": "github",
        "repo": "wshobson/agents"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  }
}
